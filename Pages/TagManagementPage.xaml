<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="NKKSeatBangpoo.Pages.TagManagementPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="🎴 RFID Tag Management"
    BackgroundColor="#1A1A2E"
    Loaded="OnPageLoaded">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="30">

        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" Spacing="4" Margin="0,10,0,20">
            <Label Text="🎴 Tag Lifecycle Management" FontSize="26" FontAttributes="Bold" TextColor="White"/>
            <Label Text="จัดการสถานะการใช้งาน RFID Card และการคืนบัตร (Recycle)"
                   FontSize="13" TextColor="#8888BB"/>
        </VerticalStackLayout>

        <!-- Search & Control -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" Margin="0,0,0,16">
            <Border Grid.Column="0" BackgroundColor="#2A2A4E"
                    StrokeShape="RoundRectangle 10" Stroke="#4444AA" Padding="12,8">
                <Grid ColumnDefinitions="Auto,*">
                    <Label Grid.Column="0" Text="🔍" FontSize="16" VerticalOptions="Center" Margin="0,0,8,0"/>
                    <Entry Grid.Column="1" x:Name="SearchEntry"
                           Placeholder="ค้นหา Tag EPC, Order No."
                           PlaceholderColor="#6666AA" TextColor="White"
                           BackgroundColor="Transparent"
                           TextChanged="OnSearchTextChanged"/>
                </Grid>
            </Border>
            <Button Grid.Column="1" Text="🔄 รีเฟรช" 
                    BackgroundColor="#3D3D9E" TextColor="White"
                    CornerRadius="8" Clicked="OnRefreshClicked"/>
            <Button Grid.Column="2" Text="🧹 คืนบัตร (Recycle)" 
                    BackgroundColor="#AA3333" TextColor="White"
                    CornerRadius="8" Clicked="OnRecycleClicked" x:Name="BtnRecycle" IsEnabled="False"/>
        </Grid>

        <!-- Table Header -->
        <Grid Grid.Row="2" RowDefinitions="Auto,*">
            <Border Grid.Row="0" BackgroundColor="#2A2A4E" StrokeShape="RoundRectangle 8" Padding="12,10" Margin="0,0,0,4">
                <Grid ColumnDefinitions="40,*,180,180,120,100">
                    <Label Grid.Column="1" Text="Tag EPC" TextColor="#AAAAFF" FontAttributes="Bold" FontSize="12"/>
                    <Label Grid.Column="2" Text="Order No" TextColor="#AAAAFF" FontAttributes="Bold" FontSize="12"/>
                    <Label Grid.Column="3" Text="NHK Part No" TextColor="#AAAAFF" FontAttributes="Bold" FontSize="12"/>
                    <Label Grid.Column="4" Text="Register Time" TextColor="#AAAAFF" FontAttributes="Bold" FontSize="12"/>
                    <Label Grid.Column="5" Text="สถานะ" TextColor="#AAAAFF" FontAttributes="Bold" FontSize="12" HorizontalOptions="Center"/>
                </Grid>
            </Border>

            <!-- Data List -->
            <CollectionView Grid.Row="1" x:Name="BindingList" SelectionMode="Multiple" 
                           SelectionChanged="OnSelectionChanged"
                           BackgroundColor="Transparent">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,4"
                                BackgroundColor="#20202E"
                                StrokeShape="RoundRectangle 6"
                                Stroke="#333355" StrokeThickness="1" Padding="12,10">
                            <Grid ColumnDefinitions="40,*,180,180,120,100">
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="{Binding TagEPC}" TextColor="#CCCCFF" FontSize="12" FontAttributes="Bold" VerticalOptions="Center"/>
                                <Label Grid.Column="2" Text="{Binding OrderNo}" TextColor="#AAAAAA" FontSize="12" VerticalOptions="Center"/>
                                <Label Grid.Column="3" Text="{Binding NHKPartNo}" TextColor="White" FontSize="12" VerticalOptions="Center"/>
                                <Label Grid.Column="4" Text="{Binding RegisterTimeStr}" TextColor="#8888AA" FontSize="11" VerticalOptions="Center"/>
                                <Border Grid.Column="5" BackgroundColor="{Binding StatusBgColor}" StrokeShape="RoundRectangle 4" Padding="6,3" HorizontalOptions="Center">
                                    <Label Text="{Binding StatusText}" TextColor="White" FontSize="10"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- Status Summary -->
        <Border Grid.Row="3" BackgroundColor="#1E1E2E" Padding="16,10" Margin="0,10,0,0" StrokeShape="RoundRectangle 10">
            <HorizontalStackLayout Spacing="20">
                <Label TextColor="#8888AA" VerticalOptions="Center">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="ทั้งหมด: "/>
                            <Span x:Name="LblTotal" Text="0" FontAttributes="Bold" TextColor="White"/>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <Label TextColor="#8888AA" VerticalOptions="Center">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="รอส่งออก: "/>
                            <Span x:Name="LblPending" Text="0" FontAttributes="Bold" TextColor="#AAAAFF"/>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <Label TextColor="#8888AA" VerticalOptions="Center">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="ส่งออกแล้ว: "/>
                            <Span x:Name="LblExported" Text="0" FontAttributes="Bold" TextColor="#44DD88"/>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <Label x:Name="LblSelection" Text="เลือก 0 รายการ" TextColor="#FFDD88" FontAttributes="Bold" VerticalOptions="Center" Margin="50,0,0,0"/>
            </HorizontalStackLayout>
        </Border>

        <ActivityIndicator Grid.Row="2" x:Name="LoadingIndicator" IsRunning="False" IsVisible="False"
                         Color="#4444AA" VerticalOptions="Center" HorizontalOptions="Center" Scale="2"/>
    </Grid>
</ContentPage>
